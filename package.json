{
  "name": "with-handlebars-web",
  "version": "0.1.0",
  "description": "With Handlebars — master scales and chords on the guitar",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:ios": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:run": "npm run build:ios && npx cap run ios",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc -b",
    "og": "tools/render-og.sh",
    "icon": "tools/render-icon.sh",
    "splash": "tools/render-splash.sh",
    "shots": "tools/render-shots.sh",
    "listen": "node --experimental-strip-types tools/listen/run.ts"
  },
  "dependencies": {
    "@anunnakicosmocrew/handlebars": "file:../with-handlebars",
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/share": "^8.0.1",
    "pinia": "^4.0.3",
    "smplr": "^1.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.0",
    "happy-dom": "^20.0.0",
    "playwright": "1.63.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^3.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnunnakiCosmoCrew/with-handlebars-web.git"
  },
  "author": "Anunnaki Cosmo Crew"
}
